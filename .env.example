# 复制为 .env，只需修改模型目录。路径中有空格时保留引号。
MODEL_DIR="/data/models/Qwen3.8-27B"

# 按 nvidia-smi 的 index 或完整 UUID 选卡，顺序决定进程内编号。
# 默认使用四卡。两卡示例 GPU_IDS="0,1"。
GPU_IDS="0,1,2,3"
CTX_SIZE=32768
PORT=8080
HOST=127.0.0.1

# f16 或 q8_0。更改后需要重新执行 convert 或 deploy。
PRECISION=f16
VISION=0
FLASH_ATTN=auto
BUILD_JOBS=8

# 可指定已安装的 CUDA Toolkit，例如 /usr/local/cuda-12.8。
CUDA_HOME=""

# 首次下载源码时可指定提交或 tag。留空使用当时的默认分支。
# 后续 setup 复用源码，.runtime/llama-cpp-commit.txt 记录实际提交。
LLAMA_REF=""
