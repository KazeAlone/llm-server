# 复制为 .env，只需修改模型目录。路径中有空格时保留引号。
MODEL_DIR="/data/models/Qwen3.8-27B"

# 按 nvidia-smi 的 index 或完整 UUID 选卡，顺序决定进程内编号。
# 默认使用四卡。两卡示例 GPU_IDS="0,1"。
GPU_IDS="0,1,2,3"
CTX_SIZE=32768
PORT=8080
HOST=127.0.0.1

# 填写后启用推理 API 鉴权，客户端的 API Key 填同一字符串。
# .env 已被 Git 忽略。可用 python -c 'import secrets; print(secrets.token_hex(32))' 生成。
API_KEY=""

# f16 或 q8_0。更改后需要重新执行 convert 或 deploy。
PRECISION=f16
VISION=0
# 本地媒体目录。默认 /；可限制为 /data/images，设为空字符串可关闭本地文件访问。
# file:// 路径相对于此目录，并由模型服务器读取。图片输入还需要 VISION=1。
MEDIA_PATH="/"
FLASH_ATTN=auto
# 留空沿用模型默认。测试等待正文过久时，可设 low，再用真实任务比较质量。
REASONING_EFFORT=""
# 主要影响长输入的处理速度。先用默认值，有显存余量再比较 UBATCH_SIZE=256。
BATCH_SIZE=512
UBATCH_SIZE=128
BUILD_JOBS=8

# auto 会优先使用当前激活的 Conda；否则创建 .runtime/venv。
# conda 强制要求已激活 Conda，venv 强制使用 .runtime/venv。
PYTHON_ENV=conda

# venv 模式创建环境所用的解释器，要求 >=3.10，建议 3.11/3.12。
PYTHON_BIN=python3

# 可指定已安装的 CUDA Toolkit，例如 /usr/local/cuda-12.8。
CUDA_HOME=""

# 首次下载源码时可指定提交或 tag。留空使用当时的默认分支。
# 后续 setup 复用源码，.runtime/llama-cpp-commit.txt 记录实际提交。
LLAMA_REF=""
