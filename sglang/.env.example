# Shell 配置。先 conda activate 环境，再 setup；不创建隐藏 venv。
MODEL_DIR="/data/models/Qwen3.8-27B"
MODEL_ID="qwen3.8-27b"
GPU_IDS="0,1,2,3"
HOST="127.0.0.1"
PORT=8083
API_KEY=""
CTX_SIZE=8192
VISION=1
# 本机文件的服务端绝对目录；/ 延续之前允许整个文件系统的配置。
# Transformers/vLLM 可设为空禁用 file://，也可收窄目录。
MEDIA_PATH="/"
# CUDA_HOME="/usr/local/cuda-12.8"
BUILD_JOBS=4
# 参数数组，禁止用包含空格的单个字符串。
EXTRA_ARGS=()
GPU_MEMORY_UTILIZATION=0.80
MAX_RUNNING_REQUESTS=1
CHUNK_SIZE=1024
# SGLANG_REF="d85b3e2705411df781dadf9e8fa4db52c8f07a5a"
UI_HOST="127.0.0.1"
UI_PORT=8183
